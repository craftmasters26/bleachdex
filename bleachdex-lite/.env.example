# Copy this file to .env and fill in real values.
# Never commit your actual .env file.

# Get this from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Password to log into the web admin panel (pick anything, keep it private)
ADMIN_PANEL_PASSWORD=change-me

# Random string used to sign admin panel session cookies (pick anything long/random)
ADMIN_PANEL_SECRET=change-me-too

# Port the admin panel / player dashboard listens on
ADMIN_PANEL_PORT=5000

# Comma-separated Discord user IDs allowed to use bot-admin-only commands
# (/character add, /weapon add, /change character, /change weapon, /edit card,
# /spawn character, /spawn weapon). This is intentionally separate from
# Discord server "Administrator" permission - only IDs listed here work,
# even on a server where you're the owner.
ADMIN_USER_IDS=

# --- Player dashboard (Discord OAuth login) - optional ---
# From https://discord.com/developers/applications -> your app -> OAuth2 tab.
BLEACHDEX_CLIENT_ID=
BLEACHDEX_CLIENT_SECRET=

# --- Public URL / ngrok tunnel - optional, only needed if you want the
# admin panel and player dashboard reachable from outside your host ---
BLEACHDEX_BASE_URL=http://localhost:5000
BLEACHDEX_NGROK_AUTHTOKEN=
BLEACHDEX_NGROK_DOMAIN=
